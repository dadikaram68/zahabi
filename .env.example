# Aldhahabi Accounting - Environment Variables
# Copy this file to .env and fill in your actual values

# Required - must be at least 32 characters
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Required - database connection string
DATABASE_URL=mysql://user:password@host:port/database

# Optional
NODE_ENV=development
PORT=3000

# OAuth
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=

# Forge API
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
BUILT_IN_FORGE_API_KEY=

# App
VITE_APP_ID=
VITE_APP_TITLE=الذهبي للمحاسبة
VITE_ANALYTICS_ENDPOINT=https://manus-analytics.com

# =============================================================================
# DOCKER (Zahabi stack) — values consumed by docker-compose.yml
# Copy this whole file to .env, then change the values below.
# =============================================================================

# --- MySQL container -------------------------------------------------------
# Database name / app user created on first boot (persisted in db_data volume)
DB_NAME=zahabi
DB_USER=zahabi
# IMPORTANT: use URL-safe passwords here (letters + digits only), because they
# are embedded in DATABASE_URL. Generate:  openssl rand -base64 24 | tr -dc A-Za-z0-9
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password
# Host/port used by the app INSIDE Docker (defaults suit compose networking)
#DB_HOST=db
#DB_PORT_INTERNAL=3306
# Host port for MySQL (dev only, bound to 127.0.0.1 by docker-compose.override.yml)
#DB_PORT=3306

# --- Published ports --------------------------------------------------------
# Production entrypoint (nginx)  -> http://localhost:8080
HTTP_PORT=8080
# Dev entrypoint (backend+vite)  -> http://localhost:3000
APP_PORT=3000

# --- Redis (optional) -------------------------------------------------------
# Start with:  docker compose --profile redis up -d
# (the app currently does not connect to Redis; the service is provisioned
#  for session/cache offloading and future wiring via REDIS_URL)

# =============================================================================
# SECURITY NOTE: JWT_SECRET and DB passwords are REQUIRED by compose and the
# app refuses to start with weak/missing values (min 32 characters).
# =============================================================================

